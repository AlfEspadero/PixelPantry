{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PixelPantry",
  "version": "1.0.1",
  "identifier": "com.pixelpantry.app",
  "build": {
    "frontendDist": "../web",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:web"
  },
  "app": {
    "windows": [
      {
        "title": "PixelPantry",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
